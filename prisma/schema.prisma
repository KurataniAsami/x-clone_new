generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1つのPostに対して投稿者は1人だけ
model Post {
  id          Int       @id @default(autoincrement())
  content     String
  createdAt   DateTime  @default(now())
  ImageKey    String?
  ImageUrl    String?

  userId      String?
  user        User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments    Comment[]
  likes         Like[]
}

model User {
  id            String    @id   // supabaseが重複しないidを発行してくれるためautoincrementはいらない
  email         String?   @unique
  accountName   String?   
  name          String?

  posts         Post[]
  comments      Comment[]
  likes         Like[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  postId    Int
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())

  postId      Int
  post        Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId      String
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // この複合ユニークキーに対して、 postId_userIdを生成する
  @@unique([postId, userId])  // 同じユーザーが同じ投稿に何回もいいねすることを防ぐ
}


// 別のプロジェクトのテーブル
// Artist ↔ Event（多対多）
model Event {
  id              Int     @id @default(autoincrement())
  eventTitle      String?
  eventDate       DateTime
  startTime       String?
  ticketImageKey  String?
  note            String?
  songList        String?
  rating          Int?   // レビュー

  // 画像が0件でも空配列になるからオプショナルにしなくてもいい
  // memoryImage   String[]

  placeId         Int
  place           Place     @relation(fields: [placeId], references: [id])

  eventImages     EventImage[]
  artist          Artist[]
}

model Artist {
  id              Int     @id @default(autoincrement())
  name            String  @unique    // 同一アーティストを重複させない
  imageUrl        String?
  events          Event[]
}

model Place {
  id              Int           @id @default(autoincrement())
  name            String
  events          Event[]
}

model EventImage {
  id              Int     @id @default(autoincrement())
  url             String      // 存在するならurlは必ず持つ必要があるので?にしない
  comment         String?

  eventId         Int
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Pokemon {
  id      Int           @id @default(autoincrement())
  name    String
  weight  Int
  detail  String @default("")
  types   PokemonType[]
}

model Type {
  id        Int           @id @default(autoincrement())
  name      String
  pokemons  PokemonType[]
}

model PokemonType {
  id          Int     @id @default(autoincrement())
  pokemonId   Int
  typeId      Int     @map("type_id")
  pokemon     Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  type        Type    @relation(fields: [typeId], references: [id], onDelete: Cascade)
}

